{
  "manifest_version": 3,
  "name": "OTPGrabber",
  "version": "1.1.0",
  "description": "Watches your Gmail for one-time passcodes and copies the newest one to your clipboard automatically.",
  "homepage_url": "https://github.com/DilshanHarshajith/OTPGrabber",
  "permissions": [
    "alarms",
    "clipboardWrite",
    "identity",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://accounts.google.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "lib/settings.js",
      "lib/otp.js",
      "lib/gmail.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "OTPGrabber",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/autofill.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "otpgrabber-v1@dilshanharshajith.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
